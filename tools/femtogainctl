#!/bin/bash
# femtogainctl — manage the Femto Gain Controller Rev.2 EPICS IOC
#
#   femtogainctl status              service state, PREFIX, per-channel gain / readback / overload
#   femtogainctl start|stop|restart  control the systemd service
#   femtogainctl console             attach to the IOC shell (exit: Ctrl-] then "quit")
#   femtogainctl log [-n N]          tail the IOC log
#   femtogainctl prefix              show the configured PREFIX
#   femtogainctl prefix NEW:PFX:     set a new PREFIX (and restart if running)
#   femtogainctl chname              show the channel names (CH1..CH4)
#   femtogainctl chname <ch> <NAME>  rename one channel; PV = <PREFIX><NAME>Gain (restarts the IOC)
#   femtogainctl chname <N1> <N2> <N3> <N4>   set all four names at once (e.g. to swap)
#   femtogainctl config              print ioc.conf
#   femtogainctl pvs                 list PV names for the current PREFIX
#   femtogainctl gain                show the gain of all four channels
#   femtogainctl gain <ch> <gain>    set a channel gain.  <ch> = 1-4 or name (Io It If Ir)
#                                    <gain> = code 0-6, or 1e3..1e9 / E3..E9 (V/A)
#   femtogainctl ovl                 show overload state and latch of all channels
#   femtogainctl ovl reset [ch]      clear the overload latch (all channels, or one)
#   femtogainctl test [-y]           cycle every channel through codes 0..6, verify pin
#                                    readbacks, restore the original gains (CHANGES REAL GAIN)
#   femtogainctl autosave            explain the start-up gain (autosave is not used)
#   femtogainctl ip                  show current network config (netplan)
#   femtogainctl ip <IP> <GATEWAY> <DNS[,DNS2]> [NETMASK]   set static IP and apply now
#                                    (NETMASK optional: 255.255.255.0 or 24; default /24)
#   femtogainctl ip dhcp             switch to DHCP
#   femtogainctl passwd NEW          set the login password (SSH and web UI share it)
#                                    (factory reset of IP + password: GPIO reset jumper only)
#   femtogainctl hostname [NAME]     show / set hostname
#   femtogainctl setup               interactive: hostname, PREFIX, channel names, password, IP/GW/DNS (for new units)
#   femtogainctl clone-prep          clean this unit so its eMMC can be cloned as a master image
#   femtogainctl clone-prep --dry-run   show what clone-prep would do and delete, change nothing
#   femtogainctl web                 web UI status / URL
#   femtogainctl web port NNNN       change the web UI port
#   femtogainctl web enable|disable  turn the web UI service on / off
#   femtogainctl build               rebuild the IOC (make)
#   femtogainctl run                 run IOC in foreground (dev; stop service first)
set -e
TOP=/usr/local/epics/iocs/femtogain
BOOT=$TOP/iocBoot/iocfemtogain
CONF=$BOOT/ioc.conf
SVC=femtogain-ioc.service
EPICS_BASE=${EPICS_BASE:-/usr/local/epics/base}
export PATH=$EPICS_BASE/bin/linux-aarch64:$PATH
export EPICS_CA_ADDR_LIST=${EPICS_CA_ADDR_LIST:-127.0.0.1} EPICS_CA_AUTO_ADDR_LIST=NO

conf_get() { sed -n "s/^[[:space:]]*$1=\([^#]*\).*/\1/p" "$CONF" | tail -1 | tr -d '[:space:]'; }
prefix()   { local p; p=$(conf_get PREFIX); echo "${p:-GC01:}"; }
port()     { local p; p=$(conf_get CONSOLE_PORT); echo "${p:-20000}"; }
active()   { systemctl is-active --quiet $SVC; }
need_root(){ [ "$(id -u)" = 0 ] || exec sudo -E "$0" "$@"; }
need_ioc() { active || { echo "error: IOC is not running (femtogainctl start)" >&2; exit 1; }; }

# ---------------------------------------------------------------- channels
GAIN_STR=(E3 E4 E5 E6 E7 E8 E9)
ch_name() {  # 1-4 -> signal name from ioc.conf
    local d=(Io It If Ir) n; n=$(conf_get "CH$1_NAME"); echo "${n:-${d[$1-1]}}"
}
ch_index() { # "2" or "It" -> 2 ; fails if unknown
    local a=$1 i
    [[ "$a" =~ ^[1-4]$ ]] && { echo "$a"; return 0; }
    for i in 1 2 3 4; do [ "${a,,}" = "$(ch_name $i | tr 'A-Z' 'a-z')" ] && { echo $i; return 0; }; done
    return 1
}
ch_usage() { echo "$(ch_name 1) $(ch_name 2) $(ch_name 3) $(ch_name 4)"; }
gain_code() { # "3" -> 3 ; "1e6" / "E6" / "1e6V/A" -> 3 ; fails outside 0-6
    local g=${1^^}; g=${g%V/A}
    [[ "$g" =~ ^[0-6]$ ]] && { echo "$g"; return 0; }
    [[ "$g" =~ ^1?E\+?0?([3-9])$ ]] && { echo $((BASH_REMATCH[1] - 3)); return 0; }
    return 1
}

chan_table() {  # one line per channel: gain, pin readback, V/A, overload, latch
    local p i n pvs=() v f; p=$(prefix)
    for i in 1 2 3 4; do n=$(ch_name $i)
        pvs+=("${p}${n}Gain" "${p}${n}Gain-RB" "${p}${n}Overload" "${p}${n}OverloadLatch"); done
    mapfile -t v < <(caget -t -w 2 "${pvs[@]}" 2>/dev/null)
    if [ ${#v[@]} -ne 16 ]; then
        echo "  (no response from the channel PVs — IOC still starting?)"; return 1; fi
    mapfile -t f < <(caget -t -w 2 -e 0 "${p}$(ch_name 1)GainFactor-RB" "${p}$(ch_name 2)GainFactor-RB" \
                                         "${p}$(ch_name 3)GainFactor-RB" "${p}$(ch_name 4)GainFactor-RB" 2>/dev/null)
    printf "  %-3s %-5s %-5s %-9s %-7s %-9s %s\n" CH NAME GAIN READBACK V/A OVERLOAD LATCH
    for i in 1 2 3 4; do
        local g=${v[$(((i-1)*4))]} rb=${v[$(((i-1)*4+1))]} note=""
        [ "$g" = "$rb" ] || note="  <-- pins differ from the setting"
        printf "  %-3s %-5s %-5s %-9s %-7s %-9s %s%s\n" "$i" "$(ch_name $i)" "$g" "$rb" "${f[$((i-1))]:-?}" \
               "${v[$(((i-1)*4+2))]}" "${v[$(((i-1)*4+3))]}" "$note"
    done
}

cmd_status() {
    echo "Service : $(systemctl is-active $SVC 2>/dev/null || true)  (enabled: $(systemctl is-enabled $SVC 2>/dev/null || echo no))"
    echo "PREFIX  : $(prefix)"
    echo "Console : telnet localhost $(port)"
    echo "Config  : $CONF"
    echo "Log     : /var/log/femtogain/ioc.log"
    if systemctl is-active --quiet femtogain-reset.service; then
        echo "Reset   : GPIO jumper/switch on line $(conf_get RESET_LINE) (header pin $(conf_get RESET_PIN) to GND 34), $(conf_get RESET_HOLD_SEC)s -> default IP + password"
    fi
    if systemctl is-active --quiet femtogain-web.service; then
        echo "Web UI  : http://$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1):$(web_get WEB_PORT 8080)/   (login: $(login_user), same password as SSH)"
    fi
    if active; then
        echo -n "Live PV : "
        if hb=$(caget -t -w 2 "$(prefix)Info:Heartbeat" 2>/dev/null); then
            echo "$(prefix)Info:Heartbeat = $hb"
            chan_table || true
        else
            echo "no response from $(prefix)Info:Heartbeat (IOC still starting?)"
        fi
    fi
}

cmd_prefix() {
    if [ -z "$1" ]; then prefix; return; fi
    local new="$1"
    if ! [[ "$new" =~ ^[A-Za-z0-9_:\-]{1,30}$ ]]; then
        echo "error: PREFIX may contain only [A-Za-z0-9_:-] (max 30 chars). Got: '$new'" >&2; exit 2
    fi
    [[ "$new" == *: ]] || echo "warning: PREFIX usually ends with ':' (e.g. GC01:)" >&2
    need_root prefix "$@"
    local old; old=$(prefix)
    if grep -qE '^[[:space:]]*PREFIX=' "$CONF"; then
        sed -i -E "s|^([[:space:]]*PREFIX=)[^#]*|\1$new|" "$CONF"
    else
        printf '\nPREFIX=%s\n' "$new" >> "$CONF"
    fi
    echo "PREFIX: $old  ->  $new   ($CONF)"
    if active; then
        echo "restarting $SVC ..."; systemctl restart $SVC; sleep 3; cmd_status
    else
        echo "IOC not running; new prefix takes effect on next start."
    fi
}

cmd_pvs() {
    local p i; p=$(prefix)
    sed -n 's/^record([a-z]*, *"\$(P)\([^"]*\)").*/\1/p' "$TOP/femtogainApp/Db/femtogain.db" | sed "s|^|$p|"
    for i in 1 2 3 4; do
        sed -n 's/^record([a-z]*, *"\$(P)\$(S)\([^"]*\)").*/\1/p' "$TOP/femtogainApp/Db/femtogainCh.template" \
            | grep -v '_$' | sed "s|^|$p$(ch_name $i)|"
    done
}

cmd_gain() {
    need_ioc
    if [ $# -eq 0 ]; then chan_table; return; fi
    [ $# -eq 2 ] || { echo "usage: femtogainctl gain <ch> <gain>    ch: 1-4 or $(ch_usage)   gain: 0-6 or 1e3..1e9" >&2; exit 2; }
    local i code p n rb
    i=$(ch_index "$1")    || { echo "error: channel must be 1-4 or one of: $(ch_usage) (got '$1')" >&2; exit 2; }
    code=$(gain_code "$2") || { echo "error: gain must be a code 0-6 or 1e3..1e9 V/A (got '$2'); code 7 is not defined on the DLPCA-200" >&2; exit 2; }
    p=$(prefix); n=$(ch_name "$i")
    caput -n -t -w 2 "${p}${n}Gain" "$code" >/dev/null
    sleep 0.3
    rb=$(caget -t -n -w 2 "${p}${n}Gain-RB")
    echo "CH$i ($n): gain ${GAIN_STR[$code]} = 1e$((code+3)) V/A (code $code), pin readback code $rb"
    [ "$rb" = "$code" ] || { echo "error: pin readback does not match" >&2; exit 1; }
}

cmd_ovl() {
    need_ioc
    local p i n; p=$(prefix)
    if [ "${1:-}" = reset ]; then
        if [ -n "${2:-}" ]; then
            i=$(ch_index "$2") || { echo "error: channel must be 1-4 or one of: $(ch_usage) (got '$2')" >&2; exit 2; }
            set -- "$i"
        else set -- 1 2 3 4; fi
        for i in "$@"; do caput -t -w 2 "${p}$(ch_name "$i")OverloadReset" 1 >/dev/null; done
        sleep 0.3
    elif [ -n "${1:-}" ]; then
        echo "usage: femtogainctl ovl [reset [ch]]" >&2; exit 2
    fi
    printf "  %-3s %-5s %-9s %-9s %s\n" CH NAME OVERLOAD LATCH COUNT
    for i in 1 2 3 4; do n=$(ch_name $i)
        printf "  %-3s %-5s %-9s %-9s %s\n" "$i" "$n" "$(caget -t -w 2 "${p}${n}Overload")" "$(caget -t -w 2 "${p}${n}OverloadLatch")" "$(caget -t -w 2 "${p}${n}OverloadCount")"
    done
}

cmd_autosave() {
    local g; g=$(conf_get DEFAULT_GAIN 2>/dev/null); g=${g:-0}
    echo "Autosave  : not used (removed 2026-11-26). Gains are not saved."
    echo "Start gain: every IOC start sets all channels to DEFAULT_GAIN=$g (${GAIN_STR[$g]:-?}) from ioc.conf"
}

# ---------------------------------------------------------------- channel names
valid_chname() { [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_-]{0,15}$ ]]; }
conf_set() {  # KEY VALUE -> replace the line in ioc.conf, or append it
    if grep -qE "^[[:space:]]*$1=" "$CONF"; then
        sed -i -E "s|^([[:space:]]*$1=)[^#]*|\1$2|" "$CONF"
    else
        printf '%s=%s\n' "$1" "$2" >> "$CONF"
    fi
}
cmd_chname() {
    local p i; p=$(prefix)
    if [ $# -eq 0 ]; then
        printf "  %-3s %-17s %s\n" CH NAME "GAIN PV"
        for i in 1 2 3 4; do printf "  %-3s %-17s %s\n" "$i" "$(ch_name $i)" "${p}$(ch_name $i)Gain"; done
        return
    fi
    local new=()
    for i in 1 2 3 4; do new[$i]=$(ch_name $i); done
    if [ $# -eq 2 ]; then
        [[ "$1" =~ ^[1-4]$ ]] || { echo "error: channel must be 1-4 (got '$1')" >&2; exit 2; }
        new[$1]=$2
    elif [ $# -eq 4 ]; then
        new[1]=$1; new[2]=$2; new[3]=$3; new[4]=$4
    else
        cat >&2 <<USAGE
usage: femtogainctl chname                      show the channel names
       femtogainctl chname <ch> <NAME>          rename one channel (ch = 1-4)
       femtogainctl chname <N1> <N2> <N3> <N4>  set all four (use this to swap names)
USAGE
        exit 2
    fi
    local a b
    for i in 1 2 3 4; do
        valid_chname "${new[$i]}" || { echo "error: channel name must start with a letter and contain only [A-Za-z0-9_-], max 16 chars (got '${new[$i]}')" >&2; exit 2; }
    done
    for a in 1 2 3; do for b in $(seq $((a+1)) 4); do
        [ "${new[$a],,}" != "${new[$b],,}" ] || { echo "error: channel names must differ: CH$a and CH$b are both '${new[$a]}'" >&2; exit 2; }
    done; done
    local changed=0
    for i in 1 2 3 4; do [ "${new[$i]}" = "$(ch_name $i)" ] || changed=1; done
    [ $changed = 1 ] || { echo "channel names unchanged"; cmd_chname; return; }
    need_root chname "$@"
    for i in 1 2 3 4; do
        [ "${new[$i]}" = "$(ch_name $i)" ] || { echo "CH$i: $(ch_name $i)  ->  ${new[$i]}"; }
    done
    for i in 1 2 3 4; do conf_set "CH${i}_NAME" "${new[$i]}"; done
    echo "PV names change with the channel names (e.g. ${p}${new[1]}Gain). Clients must use the new names."
    if active; then
        echo "restarting $SVC (all gains return to the start-up gain) ..."; systemctl restart $SVC; sleep 4; cmd_chname
    else
        echo "IOC not running; new names take effect on next start."; cmd_chname
    fi
}

# ---------------------------------------------------------------- network
NETPLAN=/etc/netplan/01-netcfg.yaml
IFACE=${IFACE:-eth0}
is_ip4()   { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && { IFS=. read -r a b c d <<< "$1"; ((a<256&&b<256&&c<256&&d<256)); }; }
mask2prefix() {  # 255.255.255.0 -> 24 ; "24" -> 24
    local m=$1 n=0 o
    if [[ "$m" =~ ^[0-9]{1,2}$ ]] && ((m<=32)); then echo "$m"; return; fi
    is_ip4 "$m" || return 1
    local v=0 inv
    for o in ${m//./ }; do v=$(( (v << 8) | 10#$o )); done
    inv=$(( ~v & 0xffffffff ))                 # a valid mask is ones then zeros:
    (( (inv & (inv + 1)) == 0 )) || return 1   # its complement must be 2^k - 1
    while (( v & 0x80000000 )); do n=$((n+1)); v=$(( (v << 1) & 0xffffffff )); done
    echo "$n"
}
prefix2mask() { local p=$1 m; m=$(( p==0 ? 0 : (0xffffffff << (32-p)) & 0xffffffff )); echo "$((m>>24&255)).$((m>>16&255)).$((m>>8&255)).$((m&255))"; }
is_cidr()  { [[ "$1" =~ ^([0-9.]+)/([0-9]{1,2})$ ]] && is_ip4 "${BASH_REMATCH[1]}" && ((BASH_REMATCH[2]<=32)); }

# current values -> CUR_ADDR CUR_GW CUR_DNS CUR_DHCP
net_current() {
    eval "$(python3 - "$NETPLAN" "$IFACE" <<'EOF'
import sys, yaml
try:
    e = yaml.safe_load(open(sys.argv[1]))["network"]["ethernets"][sys.argv[2]]
except Exception:
    e = {}
addr = (e.get("addresses") or [""])[0]
gw = e.get("gateway4") or ""
for r in e.get("routes") or []:
    if str(r.get("to")) in ("default", "0.0.0.0/0"): gw = r.get("via", gw)
dns = ",".join((e.get("nameservers") or {}).get("addresses") or [])
print(f'CUR_ADDR="{addr}" CUR_GW="{gw}" CUR_DNS="{dns}" CUR_DHCP="{str(e.get("dhcp4", False)).lower()}"')
EOF
)"
}

net_show() {
    net_current
    echo "Interface : $IFACE   (file: $NETPLAN)"
    if [ "$CUR_DHCP" = true ]; then echo "Mode      : DHCP"; else
        echo "Address   : ${CUR_ADDR:-?}"; echo "Gateway   : ${CUR_GW:-?}"; echo "DNS       : ${CUR_DNS:-?}"; fi
    echo "Live      : $(ip -4 -br addr show "$IFACE" 2>/dev/null | awk '{print $3}')  gw $(ip route show default 2>/dev/null | awk '/via/{print $3; exit}')"
    echo "Hostname  : $(hostname)"
    echo "Default   : $(conf_get DEFAULT_IP)/$(mask2prefix "$(conf_get DEFAULT_NETMASK)" 2>/dev/null || echo 24)  gw $(conf_get DEFAULT_GATEWAY)  dns $(conf_get DEFAULT_DNS)   (GPIO reset jumper / clone-prep only)"
}

# factory defaults from ioc.conf -> DEF_IP DEF_MASK DEF_GW DEF_DNS
net_defaults() {
    DEF_IP=$(conf_get DEFAULT_IP); DEF_MASK=$(conf_get DEFAULT_NETMASK); DEF_GW=$(conf_get DEFAULT_GATEWAY); DEF_DNS=$(conf_get DEFAULT_DNS)
    DEF_IP=${DEF_IP:-10.0.147.1}; DEF_MASK=${DEF_MASK:-255.255.255.0}; DEF_GW=${DEF_GW:-10.0.147.99}; DEF_DNS=${DEF_DNS:-8.8.8.8}
}

net_write_static() {   # addr/cidr gw dns1,dns2
    local addr=$1 gw=$2 dns=$3 dnsyaml
    dnsyaml=$(echo "$dns" | sed 's/,/, /g')
    cp -a "$NETPLAN" "$NETPLAN.bak" 2>/dev/null || true
    cat > "$NETPLAN" <<EOF
# written by femtogainctl ip  ($(date '+%F %T'))
network:
  version: 2
  renderer: networkd
  ethernets:
    $IFACE:
      dhcp4: false
      addresses:
        - $addr
      routes:
        - to: default
          via: $gw
      nameservers:
        addresses: [$dnsyaml]
EOF
    chmod 600 "$NETPLAN"
}

net_write_dhcp() {
    cp -a "$NETPLAN" "$NETPLAN.bak" 2>/dev/null || true
    cat > "$NETPLAN" <<EOF
# written by femtogainctl ip dhcp  ($(date '+%F %T'))
network:
  version: 2
  renderer: networkd
  ethernets:
    $IFACE:
      dhcp4: true
EOF
    chmod 600 "$NETPLAN"
}

net_apply() {
    if ! netplan generate 2>/tmp/femtogain-netplan.err; then
        echo "error: netplan rejected the config:" >&2; cat /tmp/femtogain-netplan.err >&2
        [ -f "$NETPLAN.bak" ] && { cp -a "$NETPLAN.bak" "$NETPLAN"; echo "restored previous $NETPLAN" >&2; }
        exit 1
    fi
    netplan apply
    sleep 2
    net_show
}

cmd_ip() {
    if [ $# -eq 0 ] && [ -t 0 ]; then
        net_show; echo
        net_current
        local cur_ip=${CUR_ADDR%%/*} cur_pfx=${CUR_ADDR##*/} a g d m
        [ "$cur_pfx" = "$CUR_ADDR" ] && cur_pfx=24
        read -r -p "IP address [${cur_ip:-192.168.0.100}] (or 'dhcp'): " a; a=${a:-${cur_ip:-192.168.0.100}}
        if [ "$a" = dhcp ]; then set -- dhcp; else
            read -r -p "Netmask [$(prefix2mask "${cur_pfx:-24}")]: " m; m=${m:-$(prefix2mask "${cur_pfx:-24}")}
            read -r -p "Gateway [${CUR_GW}]: " g; g=${g:-$CUR_GW}
            read -r -p "DNS (comma separated) [${CUR_DNS:-8.8.8.8}]: " d; d=${d:-${CUR_DNS:-8.8.8.8}}
            set -- "$a" "$g" "$d" "$m"
        fi
    fi
    [ $# -eq 0 ] && { net_show; return; }
    need_root ip "$@"
    if [ "$1" = dhcp ]; then
        net_write_dhcp; echo "-> DHCP on $IFACE"; net_apply; return
    fi
    [ $# -ge 2 ] || { echo "usage: femtogainctl ip <IP> <GATEWAY> [DNS[,DNS2]] [NETMASK]   |   femtogainctl ip dhcp" >&2; exit 2; }
    local addr=$1 gw=$2 dns=${3:-8.8.8.8} d pfx
    if is_ip4 "$addr"; then                      # plain IP: netmask from 4th arg, default /24
        pfx=$(mask2prefix "${4:-24}") || { echo "error: bad netmask '$4' (e.g. 255.255.255.0 or 24)" >&2; exit 2; }
        addr="$addr/$pfx"
    fi
    is_cidr "$addr" || { echo "error: bad IP address '$1' (e.g. 10.0.147.198)" >&2; exit 2; }
    is_ip4 "$gw"    || { echo "error: bad gateway '$gw'" >&2; exit 2; }
    for d in ${dns//,/ }; do is_ip4 "$d" || { echo "error: bad DNS address '$d'" >&2; exit 2; }; done
    dns=$(echo "$dns" | tr -s ' ,' ',' | sed 's/^,//;s/,$//')
    net_write_static "$addr" "$gw" "$dns"
    echo "-> $IFACE static: $addr (netmask $(prefix2mask "${addr##*/}"))  gw $gw  dns $dns"
    echo "   (if you are connected over SSH to the old address, this session will drop)"
    net_apply
}

cmd_hostname() {
    [ -z "$1" ] && { hostname; return; }
    [[ "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] || { echo "error: invalid hostname '$1'" >&2; exit 2; }
    need_root hostname "$1"
    local old; old=$(hostname)
    hostnamectl set-hostname "$1"
    if grep -qE '^127\.0\.1\.1[[:space:]]' /etc/hosts; then
        sed -i -E "s/^(127\.0\.1\.1[[:space:]]+).*/\1$1/" /etc/hosts
    else
        printf '127.0.1.1\t%s\n' "$1" >> /etc/hosts
    fi
    echo "hostname: $old -> $1"
}

cmd_setup() {
    need_root setup
    echo "=== Femto Gain Controller unit setup (Enter keeps the current value) ==="
    local h p pw
    read -r -p "Hostname [$(hostname)]: " h; h=${h:-$(hostname)}
    [ "$h" != "$(hostname)" ] && cmd_hostname "$h"
    read -r -p "EPICS PV prefix [$(prefix)]: " p; p=${p:-$(prefix)}
    [ "$p" != "$(prefix)" ] && cmd_prefix "$p"
    local cur names; cur="$(ch_name 1) $(ch_name 2) $(ch_name 3) $(ch_name 4)"
    read -r -p "Channel names CH1 CH2 CH3 CH4 [$cur]: " names; names=${names:-$cur}
    # shellcheck disable=SC2086
    [ "$names" != "$cur" ] && cmd_chname $names
    read -r -s -p "New login password for $(login_user) [keep]: " pw; echo
    [ -n "$pw" ] && cmd_password "$pw"
    echo; echo "--- Network ---"
    cmd_ip
}

# ---------------------------------------------------------------- login / reset
login_user() { local u; u=$(conf_get DEFAULT_USER); echo "${u:-root}"; }
cmd_password() {
    [ -n "${1:-}" ] || { echo "usage: femtogainctl passwd NEW" >&2; exit 2; }
    [ ${#1} -ge 4 ] || { echo "error: password must be at least 4 characters" >&2; exit 2; }
    [[ "$1" != *$'\n'* ]] || { echo "error: password must not contain a newline" >&2; exit 2; }
    need_root passwd "$1"
    printf '%s:%s\n' "$(login_user)" "$1" | chpasswd
    echo "password updated for $(login_user) (SSH + web UI)"
}
# ---------------------------------------------------------------- web UI
WEBCONF=$BOOT/web.conf
WEBSVC=femtogain-web.service
web_get() { local v; v=$(sed -n "s/^[[:space:]]*$1=\([^#]*\).*/\1/p" "$WEBCONF" 2>/dev/null | tail -1 | tr -d '[:space:]'); echo "${v:-$2}"; }
web_set() { need_root web "$@"; if grep -qE "^[[:space:]]*$1=" "$WEBCONF"; then sed -i -E "s|^([[:space:]]*$1=).*|\1$2|" "$WEBCONF"; else printf '%s=%s\n' "$1" "$2" >> "$WEBCONF"; fi; chmod 600 "$WEBCONF"; }
cmd_web() {
    case "${1:-}" in
        "")  echo "Service : $(systemctl is-active $WEBSVC 2>/dev/null)  (enabled: $(systemctl is-enabled $WEBSVC 2>/dev/null || echo no))"
             echo "URL     : http://$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1):$(web_get WEB_PORT 8080)/"
             echo "Login   : $(web_get WEB_USER "$(login_user)")  (same password as SSH; change: femtogainctl passwd NEW)"
             echo "Config  : $WEBCONF" ;;
        password|passwd) shift; cmd_password "$@" ;;
        port)    { [[ "${2:-}" =~ ^[0-9]{2,5}$ ]] && ((10#$2 <= 65535)); } || { echo "usage: femtogainctl web port NNNN" >&2; exit 2; }
             web_set WEB_PORT "$2"; systemctl restart $WEBSVC; sleep 1; cmd_web ;;
        enable)  need_root web enable; systemctl enable --now $WEBSVC; cmd_web ;;
        disable) need_root web disable; systemctl disable --now $WEBSVC; echo "web UI stopped and disabled" ;;
        restart) need_root web restart; systemctl restart $WEBSVC; cmd_web ;;
        *) echo "usage: femtogainctl web [port NNNN | enable | disable | restart]" >&2; exit 2 ;;
    esac
}

# Work files that do not belong in a master image.  Only paths that exist
# are listed; nothing outside the login user's home is touched.
clone_work_files() {
    local h; h=$(getent passwd "$(login_user)" | cut -d: -f6); h=${h:-/root}
    local f
    for f in "$h"/femtogain-backup-* "$h"/femtogain-boot-scope "$h"/source "$h"/osc "$h"/img "$h"/md \
             "$h"/.claude "$h"/.claude.json "$h"/.claude.json.backup* "$h"/.viminfo "$h"/.cache "$h"/.Xauthority \
             "$h"/.ssh/known_hosts "$h"/.ssh/known_hosts.old "$h"/.lesshst "$h"/.python_history "$h"/.wget-hsts; do
        [ -e "$f" ] && echo "$f"
    done
    return 0
}
cmd_clone_prep() {
    local dry=0; [ "${1:-}" = "--dry-run" ] && dry=1
    [ $dry = 1 ] || need_root clone-prep
    cat <<CLONE_TEXT
This prepares THIS unit to be cloned (eMMC image).  It will:
  - check that the spi0 overlay is out of /boot/config.ini (CH3/CH4 need it) and fix it if not
  - stop the IOC and delete logs, iocsh history, pvlist
  - reset /etc/machine-id (regenerated on first boot)
  - arm a shutdown hook that deletes SSH host keys + machine-id at power-off
    (regenerated on first boot by femtogain-firstboot.service); SSH keeps working until then
  - clear apt cache, shell histories, journal
  - write the factory-default network config (DEFAULT_IP in ioc.conf) so every
    clone boots at that address; it is NOT applied now, only on the next boot
  - set the login password of $(login_user) (SSH + web) to DEFAULT_PASSWORD from ioc.conf
  - optionally delete development work files from the home directory (asked separately)
Hostname / PREFIX are kept — change them on each clone with:  femtogainctl setup
CLONE_TEXT
    net_defaults; echo "clone default network: $DEF_IP / $DEF_MASK  gw $DEF_GW  dns $DEF_DNS"
    local work; work=$(clone_work_files)
    if [ -n "$work" ]; then
        echo; echo "Development work files found (they would be copied into every clone):"
        echo "$work" | while read -r f; do printf '    %-8s %s\n' "$(du -sh "$f" 2>/dev/null | cut -f1)" "$f"; done
    fi
    echo; "$TOP/tools/femtogain-boot-overlay.sh" --check || true
    if [ $dry = 1 ]; then echo; echo "(dry run — nothing was changed)"; return 0; fi
    read -r -p "Continue? [y/N] " yn; [[ "$yn" =~ ^[Yy] ]] || { echo aborted; exit 1; }
    local delwork=n
    if [ -n "$work" ]; then
        echo "The work files above may be the ONLY copies (documents, sources, backups)."
        echo "Copy anything you need to another machine first."
        read -r -p "Delete these work files from this unit? [y/N] " delwork
    fi
    # the boot overlay must be right in the image; otherwise CH3/CH4 would not work on the clones
    "$TOP/tools/femtogain-boot-overlay.sh" || { echo "error: could not fix the boot overlay — aborting before anything else is changed" >&2; exit 1; }
    systemctl stop $SVC || true
    rm -f "$BOOT"/autosave/*.sav* "$BOOT"/autosave/*.req "$BOOT"/.iocsh_history "$BOOT"/pvlist.txt /var/log/femtogain/*
    # first-boot service: regenerate ssh host keys if missing
    cp "$BOOT/femtogain-firstboot.service" /etc/systemd/system/
    systemctl daemon-reload; systemctl enable femtogain-firstboot.service >/dev/null 2>&1
    # SSH host keys are removed at the NEXT SHUTDOWN (not now: sshd re-reads them per
    # connection, deleting them live would block new logins).  machine-id likewise.
    cp "$BOOT/femtogain-clone-finalize.service" /etc/systemd/system/ && systemctl daemon-reload
    systemctl enable --now femtogain-clone-finalize.service >/dev/null 2>&1
    local defpw; defpw=$(conf_get DEFAULT_PASSWORD); printf '%s:%s\n' "$(login_user)" "${defpw:-femto}" | chpasswd && echo "login password of $(login_user) set to default"
    # factory-default network for the clones (takes effect on next boot, this session stays up)
    local pfx; pfx=$(mask2prefix "$DEF_MASK") || pfx=24
    net_write_static "$DEF_IP/$pfx" "$DEF_GW" "$DEF_DNS"
    netplan generate || { echo "error: default network config invalid, restoring previous" >&2; cp -a "$NETPLAN.bak" "$NETPLAN"; exit 1; }
    rm -f /var/lib/dbus/machine-id; ln -s /etc/machine-id /var/lib/dbus/machine-id
    apt-get clean >/dev/null 2>&1 || true
    journalctl --rotate --vacuum-time=1s >/dev/null 2>&1 || true
    rm -f /root/.bash_history /home/*/.bash_history
    history -c 2>/dev/null || true
    if [[ "$delwork" =~ ^[Yy] ]]; then
        echo "$work" | while read -r f; do [ -n "$f" ] && rm -rf -- "$f" && echo "deleted $f"; done
    elif [ -n "$work" ]; then
        echo "work files kept — they will be part of the image"
    fi
    sync
    echo "done.  Power off now and image the eMMC:  sudo poweroff   (do NOT 'netplan apply' — the default IP $DEF_IP activates on next boot)"
    echo "On each clone after first boot:  femtogainctl setup"
}

cmd_test() {
    need_ioc
    local p fail=0 i j n code yn g0 g1 g2 rbs others r; p=$(prefix)
    if [ "${1:-}" != "-y" ] && [ "${1:-}" != "--yes" ]; then
        echo "WARNING: this test drives every channel through gain codes 0..6 (1e3..1e9 V/A)."
        echo "         If amplifiers are connected their REAL gain changes during the test"
        echo "         (about 15 s); the original gains are restored at the end."
        [ -t 0 ] || { echo "error: not a terminal — confirm with: femtogainctl test -y" >&2; exit 2; }
        read -r -p "Continue? [y/N] " yn; [[ "$yn" =~ ^[Yy] ]] || { echo aborted; exit 1; }
    fi
    local orig=() rbpvs=()
    for i in 1 2 3 4; do n=$(ch_name $i); orig[$i]=$(caget -t -n -w 2 "${p}${n}Gain"); rbpvs+=("${p}${n}Gain-RB"); done
    restore() { local k; for k in 1 2 3 4; do caput -n -t -w 2 "${p}$(ch_name $k)Gain" "${orig[$k]}" >/dev/null 2>&1 || true; done; }
    trap 'restore; echo "interrupted — original gains restored"; exit 130' INT TERM
    printf "%-4s %-5s %-5s %-5s %-3s %-3s %-3s %-4s %-7s %s\n" CH NAME CODE GAIN G2 G1 G0 RB OTHERS RESULT
    for i in 1 2 3 4; do
        n=$(ch_name $i)
        for code in 0 1 2 3 4 5 6; do
            caput -n -t -w 2 "${p}${n}Gain" $code >/dev/null; sleep 0.3
            read -r g0 g1 g2 <<< "$(caget -t -n -w 2 "${p}${n}G0-RB" "${p}${n}G1-RB" "${p}${n}G2-RB" | tr '\n' ' ')"
            mapfile -t rbs < <(caget -t -n -w 2 "${rbpvs[@]}")
            others=same
            # every other channel must still show its original gain on the pins
            for j in 1 2 3 4; do [ $j = $i ] && continue
                [ "${rbs[$((j-1))]}" = "${orig[$j]}" ] || others="CH$j!"
            done
            if [ "$g0" = $((code & 1)) ] && [ "$g1" = $(((code >> 1) & 1)) ] && [ "$g2" = $(((code >> 2) & 1)) ] \
               && [ "${rbs[$((i-1))]}" = "$code" ] && [ "$others" = same ]; then r=OK; else r=FAIL; fail=1; fi
            printf "%-4s %-5s %-5s %-5s %-3s %-3s %-3s %-4s %-7s %s\n" "$i" "$n" "$code" "${GAIN_STR[$code]}" "$g2" "$g1" "$g0" "${rbs[$((i-1))]}" "$others" "$r"
        done
        caput -n -t -w 2 "${p}${n}Gain" "${orig[$i]}" >/dev/null; sleep 0.3
    done
    trap - INT TERM
    restore; sleep 0.3
    echo "restored gains: $(for i in 1 2 3 4; do echo -n "CH$i=${GAIN_STR[${orig[$i]}]} "; done)"
    mapfile -t rbs < <(caget -t -n -w 2 "${rbpvs[@]}")
    for i in 1 2 3 4; do [ "${rbs[$((i-1))]}" = "${orig[$i]}" ] || { echo "CH$i readback ${rbs[$((i-1))]} != original ${orig[$i]}"; fail=1; }; done
    [ $fail = 0 ] && echo "ALL OK" || { echo "SOME CHECKS FAILED"; exit 1; }
}

case "${1:-status}" in
    status)   cmd_status ;;
    start|stop|restart) need_root "$@"; systemctl "$1" $SVC; sleep 2; cmd_status ;;
    enable)   need_root "$@"; systemctl enable --now $SVC; cmd_status ;;
    disable)  need_root "$@"; systemctl disable --now $SVC ;;
    console)  echo "(exit with Ctrl-] then 'quit')"; exec telnet localhost "$(port)" ;;
    log)      shift; exec tail -f "${@:--n 50}" /var/log/femtogain/ioc.log ;;
    prefix)   shift; cmd_prefix "$@" ;;
    config)   cat "$CONF" ;;
    pvs)      cmd_pvs ;;
    gain)     shift; cmd_gain "$@" ;;
    ovl|overload) shift; cmd_ovl "$@" ;;
    test)     shift; cmd_test "$@" ;;
    autosave) cmd_autosave ;;
    ip|net)   shift; cmd_ip "$@" ;;
    hostname) shift; cmd_hostname "$@" ;;
    setup)    cmd_setup ;;
    chname|chnames) shift; cmd_chname "$@" ;;
    clone-prep) shift; cmd_clone_prep "$@" ;;
    web)      shift; cmd_web "$@" ;;
    passwd|password) shift; cmd_password "$@" ;;
    build)    make -C "$TOP" "${@:2}" ;;
    run)      active && { echo "stop the service first: femtogainctl stop" >&2; exit 1; }; exec "$BOOT/start_ioc.sh" ;;
    -h|--help|help) sed -n '2,33p' "$0" ;;
    *) echo "unknown command: $1 (try: femtogainctl help)" >&2; exit 2 ;;
esac
